# ============================================================
# Backwatch — Systemd Environment Configuration
# Location: /etc/backup-health-monitor/backwatch.env
# ============================================================

# ── Basic Authentication (No DB — Admin Credentials) ──────
# Change AUTH_PASSWORD in production!
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# ── Root path of backups on this server ───────────────────
# Canonical structure: <BACKUP_ROOT>/<IP>/YYYY/MM/DD/<GROUP>/
BACKUP_ROOT=/var/backups/db

# ── Service Paths ─────────────────────────────────────────
CONFIG_PATH=/etc/backup-health-monitor/config.yml
STATE_DIR=/var/lib/backup-health-monitor
DB_PATH=/var/lib/backup-health-monitor/history.db

# ── HTTP Server & Metrics ─────────────────────────────────
# Port for Web UI & Prometheus metrics
HTTP_HOST=0.0.0.0
METRICS_PORT=9108

# ── Scanning & Logging ────────────────────────────────────
SCAN_INTERVAL_SECONDS=3600
LOG_LEVEL=INFO

# ── Alerts & Notifications ────────────────────────────────
WEBHOOK_URL=
ALERTMANAGER_URL=

# ── AI Summarization (OpenAI / Claude / OpenWebUI / Ollama) ─
# AI is optional. Summarizes deterministic results only.
AI_ENABLED=false
# Examples:
# OpenAI:           AI_URL=https://api.openai.com/v1  AI_MODEL=gpt-4o-mini  AI_PROVIDER=openai
# Anthropic Claude: AI_URL=https://api.anthropic.com/v1  AI_MODEL=claude-3-5-haiku-20241022  AI_PROVIDER=claude
# OpenWebUI:        AI_URL=https://chat.your-domain.com/api/v1  AI_MODEL=qwen2.5:7b  AI_PROVIDER=openwebui
# Local Ollama:     AI_URL=http://localhost:11434  AI_MODEL=qwen2.5:7b  AI_PROVIDER=ollama
AI_URL=http://localhost:11434
AI_MODEL=qwen2.5:7b
AI_API_KEY=
# "auto", "openai", "claude", "openwebui", or "ollama"
AI_PROVIDER=auto
