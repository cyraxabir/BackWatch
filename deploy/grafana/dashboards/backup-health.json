      "id": 5,
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Retention Candidates",
      "type": "stat",
      "targets": [{ "expr": "backup_retention_candidates", "legendFormat": "Candidates" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
