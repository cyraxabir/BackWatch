      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Restore Test Success",
      "type": "stat",
      "targets": [{ "expr": "backup_restore_test_success", "legendFormat": "Success" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 24 },
      "id": 32,
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Restore Test Failures",
      "type": "stat",
      "targets": [{ "expr": "backup_restore_test_failure", "legendFormat": "Failures" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1 } }
      },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 28 },
      "id": 33,
      "title": "File Count per Group",
      "type": "timeseries",
      "targets": [{ "expr": "backup_group_file_count", "legendFormat": "{{ server }}/{{ backup_group }}" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 104,
      "title": "Servers with Failures",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
